{
  "name": "webhook-gateway",
  "version": "0.0.1",
  "description": "Durable webhook gateway for WhatsApp and Instagram",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.0"
  },
  "type": "module",
  "scripts": {
    "build": "bun --bun nest build",
    "format": "bun --bun prettier --write \"src/**/*.ts\"",
    "dev": "bun src/app/main.ts",
    "start": "bun src/app/main.ts",
    "start:dev": "bun --watch src/app/main.ts",
    "start:debug": "bun --inspect-wait src/app/main.ts",
    "start:prod": "bun dist/app/main.js",
    "start:worker": "bun dist/worker/worker.js",
    "worker": "bun --watch src/worker/worker.ts",
    "db:generate": "bun --bun prisma generate",
    "db:migrate": "bun --bun prisma migrate dev",
    "db:deploy": "bun --bun prisma migrate deploy",
    "lint": "bun --bun oxlint src/ test/",
    "test": "bun --bun vitest run",
    "test:watch": "bun --bun vitest",
    "test:cov": "bun --bun vitest run --coverage",
    "test:debug": "bun --inspect-brk --bun vitest run --no-file-parallelism",
    "test:e2e": "bun --bun vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^18.0.4",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "undici": "^8.11.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "prisma": "^7.10.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}