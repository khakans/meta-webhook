DATABASE_URL=postgresql://postgres:postgres@localhost:5434/webhook_gateway
PORT=3100
ADMIN_API_KEY=replace-with-a-long-random-value
# Generate with: openssl rand -base64 32
GATEWAY_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
WORKER_POLL_MS=500
WORKER_BATCH_SIZE=10
DELIVERY_MAX_ATTEMPTS=8
ALLOW_HTTP_DESTINATIONS=true
# Comma-separated hostnames or IPs that may resolve to private addresses.
DESTINATION_HOST_ALLOWLIST=host.docker.internal

